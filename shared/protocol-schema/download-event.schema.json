{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xarchive.local/schema/download-event.schema.json",
  "title": "DownloadEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "event", "job_id"],
  "properties": {
    "protocol_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string" },
    "event": { "type": "string", "enum": ["ready", "started", "metadata", "progress", "file", "complete", "failed", "log"] },
    "job_id": { "type": "string", "minLength": 1 },
    "current": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "path": { "type": "string" },
    "level": { "type": "string", "enum": ["debug", "info", "warning", "error"] },
    "message": { "type": "string", "maxLength": 10000 },
    "data": { "type": "object" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "media_type": { "type": "string", "enum": ["photo", "video", "unknown"] },
    "mime_type": { "type": ["string", "null"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "size_bytes", "media_type"],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string", "enum": ["photo", "video", "unknown"] },
          "mime_type": { "type": ["string", "null"] }
        }
      }
    },
    "error_code": { "type": "string" },
    "error_message": { "type": "string" }
  }
}