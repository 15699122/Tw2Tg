{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xarchive.local/schema/archive-request.schema.json",
  "title": "ArchiveRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "message_type", "tweet"],
  "properties": {
    "protocol_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message_type": { "type": "string", "const": "archive_request" },
    "tweet": {
      "$ref": "#/$defs/tweet"
    }
  },
  "$defs": {
    "tweet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tweet_id", "url"],
      "properties": {
        "tweet_id": { "type": "string", "pattern": "^[0-9]+$" },
        "url": { "type": "string", "format": "uri" },
        "username": { "type": "string", "maxLength": 256 },
        "display_name": { "type": "string", "maxLength": 512 },
        "text": { "type": "string", "maxLength": 100000 },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "tweet_type": { "type": "string", "enum": ["post", "reply", "quote"] },
        "reply_to": { "type": ["string", "null"] },
        "quoted_tweet": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["tweet_id", "url"],
          "properties": {
            "tweet_id": { "type": "string", "pattern": "^[0-9]+$" },
            "url": { "type": "string", "format": "uri" },
            "username": { "type": ["string", "null"], "maxLength": 256 },
            "display_name": { "type": ["string", "null"], "maxLength": 512 },
            "text": { "type": ["string", "null"], "maxLength": 100000 },
            "created_at": { "type": ["string", "null"], "format": "date-time" },
            "tweet_type": { "type": "string", "enum": ["post", "reply", "quote"] },
            "reply_to": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}